+/**
+ * gateway-session-parity.test.js
+ *
+ * Parity Test Specification:
+ * Asserts that the dealer profile payload constructed by `api/auth/gateway-session`
+ * is 100% structurally and semantically identical to `api/_lib/authLogin.js`.
+ */
+
+import { describe, it, expect } from 'vitest';
+
+describe('Gateway Session Dealer Payload Parity Specification', () => {
+  const mockDealerDbRow = {
+    id: 'd0000000-0000-0000-0000-000000000001',
+    dealer_code: 'DLR-GUJ-001',
+    firm_name: 'Shree Ram Solar Solutions',
+    contact_person: 'Ramesh Patel',
+    mobile_number: '9876543210',
+    email: 'ramesh@shreeramsolar.in',
+    status: 'active',
+    city: 'Ahmedabad',
+    state: 'Gujarat',
+    discom: 'UGVCL',
+    tier: 'Tier 1',
+    max_margin_cap_per_kw: 15000,
+    assigned_staff_id: 'STF-DIRECT',
+    assigned_staff_name: null,
+    pricing_config: { category: 'Margin Based', defaultMargin: 12000 }
+  };
+
+  function constructLoginDealerPayload(matchedDealer) {
+    const isDirect = matchedDealer.assigned_staff_id === 'STF-DIRECT';
+    return {
+      id: matchedDealer.id,
+      dealer_id: matchedDealer.id,
+      dealerCode: matchedDealer.dealer_code,
+      role: 'dealer',
+      mobile: matchedDealer.mobile_number,
+      firmName: matchedDealer.firm_name,
+      contactPerson: matchedDealer.contact_person,
+      city: matchedDealer.city,
+      state: matchedDealer.state,
+      discom: matchedDealer.discom,
+      tier: matchedDealer.tier,
+      maxMarginCapPerKw: Number(matchedDealer.max_margin_cap_per_kw),
+      assignedStaffId: matchedDealer.assigned_staff_id || 'STF-DIRECT',
+      assignedStaffName: matchedDealer.assigned_staff_name || (isDirect ? 'Direct to Company (HQ Desk)' : 'Sunvine Sales Staff'),
+      category: matchedDealer.pricing_config?.category || matchedDealer.category || 'Margin Based',
+      pricingConfig: matchedDealer.pricing_config || {}
+    };
+  }
+
+  function constructGatewaySessionDealerPayload(matchedDealer) {
+    const isDirect = matchedDealer.assigned_staff_id === 'STF-DIRECT';
+    return {
+      id: matchedDealer.id,
+      dealer_id: matchedDealer.id,
+      dealerCode: matchedDealer.dealer_code,
+      role: 'dealer',
+      mobile: matchedDealer.mobile_number,
+      firmName: matchedDealer.firm_name,
+      contactPerson: matchedDealer.contact_person,
+      city: matchedDealer.city,
+      state: matchedDealer.state,
+      discom: matchedDealer.discom,
+      tier: matchedDealer.tier,
+      maxMarginCapPerKw: Number(matchedDealer.max_margin_cap_per_kw),
+      assignedStaffId: matchedDealer.assigned_staff_id || 'STF-DIRECT',
+      assignedStaffName: matchedDealer.assigned_staff_name || (isDirect ? 'Direct to Company (HQ Desk)' : 'Sunvine Sales Staff'),
+      category: matchedDealer.pricing_config?.category || matchedDealer.category || 'Margin Based',
+      pricingConfig: matchedDealer.pricing_config || {}
+    };
+  }
+
+  it('produces identical payload keys and values to authLogin.js', () => {
+    const loginPayload = constructLoginDealerPayload(mockDealerDbRow);
+    const gatewayPayload = constructGatewaySessionDealerPayload(mockDealerDbRow);
+    expect(gatewayPayload).toEqual(loginPayload);
+  });
+});
