@@ -0,0 +1,135 @@
+/**
+ * authGatewaySession.js — Machine-to-Machine Gateway Session Revalidation
+ *
+ * Authenticated strictly via HMAC-SHA256 signature over timestamp (<= 60s clock skew)
+ * using GATEWAY_HMAC_SECRET.
+ *
+ * Returns the fresh dealer profile payload (strictly mirroring api/_lib/authLogin.js
+ * dealer mapping including max_margin_cap_per_kw check) plus current account status.
+ */
+
+import crypto from 'crypto';
+import { query, getSupabaseServiceClient } from './db.js';
+
+/**
+ * Verify HMAC signature from Cloudflare Gateway.
+ * Header convention:
+ *   x-gateway-timestamp: unix epoch in milliseconds
+ *   x-gateway-signature: hex-encoded HMAC-SHA256 of timestamp
+ */
+function verifyGatewayHmac(req) {
+  const secret = process.env.GATEWAY_HMAC_SECRET;
+  if (!secret || secret.trim().length < 16) {
+    return { ok: false, status: 500, error: 'GATEWAY_HMAC_SECRET not configured or too short.' };
+  }
+
+  const timestampStr = req.headers['x-gateway-timestamp'];
+  const signature = req.headers['x-gateway-signature'];
+
+  if (!timestampStr || !signature) {
+    return { ok: false, status: 401, error: 'Missing gateway authentication headers (x-gateway-timestamp, x-gateway-signature).' };
+  }
+
+  const ts = parseInt(timestampStr, 10);
+  if (isNaN(ts)) {
+    return { ok: false, status: 401, error: 'Invalid gateway timestamp format.' };
+  }
+
+  // Normalize seconds vs ms
+  const tsMs = ts < 10000000000 ? ts * 1000 : ts;
+  const now = Date.now();
+  const skewMs = Math.abs(now - tsMs);
+
+  // Strict 60s clock skew
+  if (skewMs > 60000) {
+    return { ok: false, status: 401, error: `Gateway timestamp clock skew exceeds 60s (skew: ${skewMs}ms).` };
+  }
+
+  const expectedSig = crypto
+    .createHmac('sha256', secret.trim())
+    .update(String(timestampStr))
+    .digest('hex');
+
+  const sigBuf = Buffer.from(String(signature), 'utf8');
+  const expBuf = Buffer.from(expectedSig, 'utf8');
+
+  if (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) {
+    return { ok: false, status: 401, error: 'Invalid gateway HMAC signature.' };
+  }
+
+  return { ok: true };
+}
+
+export default async function handler(req, res) {
+  if (req.method !== 'POST') {
+    return res.status(405).json({ error: 'Method Not Allowed. Use POST.' });
+  }
+
+  const hmacCheck = verifyGatewayHmac(req);
+  if (!hmacCheck.ok) {
+    return res.status(hmacCheck.status).json({ error: hmacCheck.error });
+  }
+
+  const { dealerId, id, dealerCode } = req.body || {};
+  const lookupKey = dealerId || id || dealerCode;
+
+  if (!lookupKey) {
+    return res.status(400).json({ error: 'dealerId or dealerCode is required.' });
+  }
+
+  try {
+    let candidates = [];
+    const sql = `
+      SELECT id, dealer_code, firm_name, contact_person, mobile_number, email, status,
+             city, state, discom, tier, max_margin_cap_per_kw, assigned_staff_id,
+             assigned_staff_name, pricing_config
+      FROM dealer_accounts
+      WHERE id::text = $1 OR dealer_code = $1
+      LIMIT 1;
+    `;
+
+    try {
+      const qRes = await query(sql, [String(lookupKey)]);
+      candidates = qRes.rows || [];
+    } catch (dbErr) {
+      console.warn('[gateway-session] PostgreSQL query fallback to Supabase:', dbErr.message);
+      const db = getSupabaseServiceClient();
+      const qRes = await db
+        .from('dealer_accounts')
+        .select('id, dealer_code, firm_name, contact_person, mobile_number, email, status, city, state, discom, tier, max_margin_cap_per_kw, assigned_staff_id, assigned_staff_name, pricing_config')
+        .or(`id.eq.${lookupKey},dealer_code.eq.${lookupKey}`)
+        .limit(1);
+      candidates = qRes.data || [];
+    }
+
+    if (!candidates || candidates.length === 0) {
+      return res.status(404).json({ error: 'Dealer account not found.', status: 'not_found' });
+    }
+
+    const matchedDealer = candidates[0];
+
+    // HC-03: Dealer margin cap must come strictly from database — no hardcoded fallback
+    if (
+      matchedDealer.max_margin_cap_per_kw === null ||
+      matchedDealer.max_margin_cap_per_kw === undefined ||
+      isNaN(Number(matchedDealer.max_margin_cap_per_kw))
+    ) {
+      throw new Error(`Dealer ${matchedDealer.dealer_code || matchedDealer.id} is missing max_margin_cap_per_kw configuration in database.`);
+    }
+
+    const isDirect = matchedDealer.assigned_staff_id === 'STF-DIRECT';
+    const userPayload = {
+      id: matchedDealer.id,
+      dealer_id: matchedDealer.id,
+      dealerCode: matchedDealer.dealer_code,
+      role: 'dealer',
+      mobile: matchedDealer.mobile_number,
+      firmName: matchedDealer.firm_name,
+      contactPerson: matchedDealer.contact_person,
+      city: matchedDealer.city,
+      state: matchedDealer.state,
+      discom: matchedDealer.discom,
+      tier: matchedDealer.tier,
+      maxMarginCapPerKw: Number(matchedDealer.max_margin_cap_per_kw),
+      assignedStaffId: matchedDealer.assigned_staff_id || 'STF-DIRECT',
+      assignedStaffName: matchedDealer.assigned_staff_name || (isDirect ? 'Direct to Company (HQ Desk)' : 'Sunvine Sales Staff'),
+      category: matchedDealer.pricing_config?.category || matchedDealer.category || 'Margin Based',
+      pricingConfig: matchedDealer.pricing_config || {}
+    };
+
+    return res.status(200).json({
+      success: true,
+      status: matchedDealer.status || 'active',
+      user: userPayload
+    });
+  } catch (err) {
+    console.error('[auth/gateway-session] Unexpected error:', err.message);
+    return res.status(500).json({ error: 'Internal gateway session error.', details: err.message });
+  }
+}
